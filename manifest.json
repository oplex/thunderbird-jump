{
  "manifest_version": 3,
  "name": "Thunderbird Jump",
  "version": "1.0.0",
  "description": "Spotlight-style folder jumper for Thunderbird: fuzzy search, j1/:j shortcuts, quick folder creation. Never moves or deletes mail.",
  "author": "oplex",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-jump@oplex",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "32": "icons/jump.svg",
    "64": "icons/jump.svg"
  },
  "permissions": ["accountsRead", "accountsFolders", "storage"],
  "background": {
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Jump to folder",
    "default_icon": "icons/jump.svg",
    "default_popup": "src/palette/palette.html"
  },
  "options_ui": {
    "page": "src/options/options.html"
  },
  "commands": {
    "open-spotlight": {
      "suggested_key": { "default": "Ctrl+Shift+Space" },
      "description": "Open the jump palette centered (spotlight)"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open the jump palette from the toolbar button"
    },
    "jump-1": { "description": "Jump to shortcut j1" },
    "jump-2": { "description": "Jump to shortcut j2" },
    "jump-3": { "description": "Jump to shortcut j3" },
    "jump-4": { "description": "Jump to shortcut j4" },
    "jump-5": { "description": "Jump to shortcut j5" }
  }
}
