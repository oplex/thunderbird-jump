{
  "manifest_version": 3,
  "name": "ThunderJump",
  "version": "1.9.0",
  "description": "Spotlight-style folder jumper: press a key, type a few letters, Enter. Shortcuts, quick folder creation, optional message moving with undo, and a Manager page with faceted search.",
  "author": "oplex.se",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-jump@oplex",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/oplex/thunderjump/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "16": "icons/thunderjump-16.png",
    "32": "icons/thunderjump-32.png",
    "48": "icons/thunderjump-48.png",
    "64": "icons/thunderjump-64.png",
    "96": "icons/thunderjump-96.png",
    "128": "icons/thunderjump-128.png"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "storage",
    "menus"
  ],
  "optional_permissions": [
    "downloads",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTagsList"
  ],
  "background": {
    "scripts": [
      "src/background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "ThunderJump",
    "default_icon": "icons/thunderjump.svg",
    "default_popup": "src/palette/palette.html"
  },
  "options_ui": {
    "page": "src/options/options.html"
  },
  "commands": {
    "open-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open the jump palette centered (spotlight)"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Open the jump palette from the toolbar button"
    },
    "move-selected": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Move the selected messages (palette in move mode)"
    },
    "copy-selected": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy the selected messages (when copying is turned on)"
    },
    "tag-selected": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Tag the selected messages (when tagging is turned on)"
    },
    "undo-move": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Undo the last move"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open ThunderJump Manager"
    },
    "jump-1": {
      "description": "Jump to shortcut j1"
    },
    "jump-2": {
      "description": "Jump to shortcut j2"
    },
    "jump-3": {
      "description": "Jump to shortcut j3"
    },
    "jump-4": {
      "description": "Jump to shortcut j4"
    },
    "jump-5": {
      "description": "Jump to shortcut j5"
    }
  },
  "homepage_url": "https://github.com/oplex/thunderjump"
}
