{
  "manifest_version": 3,
  "name": "ThunderJump",
  "version": "1.6.0",
  "description": "ThunderJump: Spotlight-style folder jumper for Thunderbird. Fuzzy search, j1/:j shortcuts, quick folder creation. Never moves or deletes mail.",
  "author": "oplex",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-jump@oplex",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/oplex/thunderbird-jump/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "16": "icons/thunderjump.svg",
    "32": "icons/thunderjump.svg",
    "64": "icons/thunderjump.svg",
    "128": "icons/thunderjump.svg"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "storage",
    "menus"
  ],
  "optional_permissions": [
    "downloads",
    "messagesRead",
    "messagesMove"
  ],
  "background": {
    "scripts": [
      "src/background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "ThunderJump",
    "default_icon": "icons/thunderjump.svg",
    "default_popup": "src/palette/palette.html"
  },
  "options_ui": {
    "page": "src/options/options.html"
  },
  "commands": {
    "open-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open the jump palette centered (spotlight)"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Open the jump palette from the toolbar button"
    },
    "move-selected": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Move the selected messages (palette in move mode)"
    },
    "undo-move": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Undo the last move"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open ThunderJump Manager"
    },
    "jump-1": {
      "description": "Jump to shortcut j1"
    },
    "jump-2": {
      "description": "Jump to shortcut j2"
    },
    "jump-3": {
      "description": "Jump to shortcut j3"
    },
    "jump-4": {
      "description": "Jump to shortcut j4"
    },
    "jump-5": {
      "description": "Jump to shortcut j5"
    }
  }
}
